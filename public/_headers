/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/audio/manifest.json
  Cache-Control: no-cache

# JS/CSS built by Vite carry a content hash in their names: safe to keep for a year.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Pictures keep their names when replaced, so they are reused for a week and refreshed in the background.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Cô Thủy recordings are named from their sentence, so a re-recorded line keeps its name: one day only.
/audio/co-thuy/*
  Cache-Control: public, max-age=86400
